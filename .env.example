# make-harness configuration template.
#
# Copy to one of (first found wins):
#   ./.env                    the directory you launch make-harness from
#   ~/.make_harness/.env      your per-user default
#   <repo>/.env               next to pyproject.toml
#
# One KEY=value per line. Variables already set in your shell always win
# over this file. MAKE_HARNESS_NO_ENV=1 skips it entirely. Do not put
# comments on the same line as a value — they would become part of it.
# Keep the real .env out of version control.

# --- Backend A: any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, OpenAI)
# The base URL must include /v1; /chat/completions is appended.
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
# Leave LLM_API_KEY unset for local servers (no Authorization header is
# sent). Required for OpenAI or other hosted endpoints.
# LLM_API_KEY=sk-...

# --- Backend B: Groq cloud. Used only when LLM_ENDPOINT is unset.
# GROQ_API_KEY=gsk_...

# --- Optional
# Enables the web_search tool. Tavily is preferred when both are set.
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=BSA...

# Context-compaction threshold, in approximate tokens (chars / 4).
# HARNESS_TOKEN_BUDGET=60000

# TUI only: reasoning blocks longer than this start collapsed.
# HARNESS_REASONING_FOLD_CHARS=400

# Plain output with no ANSI colors.
# NO_COLOR=1
